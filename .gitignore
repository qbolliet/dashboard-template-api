# Modules
node_modules/
docs-site/node_modules/

# Docs build output
docs-site/build/
docs-site/.docusaurus/
docs-site/static/schema.json
docs-site/static/schema.graphql

# TypeDoc generated files (regenerated in CI)
docs-site/toolbox/code-reference/**

# graphql-markdown generated files (regenerated in CI), except the static homepage placeholder
docs-site/api/graphql-api/**
!docs-site/api/graphql-api/index.md

# Data dictionary generated from the API (npm run docs:dictionary), and its temporary render
docs-site/api/data-dictionary/
docs-site/api/data-dictionary.tmp/

# TypeScript compiled output
dist/

# Logs
logs/*
!logs/.gitkeep

# Data
data/*
!data/.gitkeep

# Environment files
*.env

# Tests
coverage/*

# Claude
CLAUDE.md
.claude/*

# Dépendances Helm téléchargées
helm/**/charts/*.tgz

