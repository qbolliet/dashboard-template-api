{
  "name": "dashboard-template-api",
  "version": "1.0.0",
  "description": "GraphQL API for DuckDB schema database",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.js'",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:setup": "node tests/setup-test-data.js",
    "test:all": "npm run test:setup && npm run test",
    "studio:test": "echo 'Ouvrez https://studio.apollographql.com et connectez-vous à http://localhost:4000/graphql'"
  },
  "repository": {
    "type": "git",
    "url": "github.com/qbolliet/dashboard-template-api"
  },
  "keywords": [
    "GraphQL",
    "DuckDB",
    "API"
  ],
  "author": "Quentin Bolliet",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "^1.2.0-alpha.15",
    "@graphql-tools/merge": "^9.0.17",
    "@graphql-tools/schema": "^10.0.16",
    "apollo-server": "^3.13.0",
    "compression": "^1.7.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.9.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "sqlstring": "^2.3.3",
    "winston": "^3.17.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "eslint": "^8.56.0"
  }
}
