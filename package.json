{
  "name": "dashboard-template-api",
  "version": "1.0.0",
  "description": "GraphQL API for DuckDB schema database",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.js'",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:setup": "node tests/setup-test-data.js",
    "test:all": "npm run test:setup && npm run test",
    "studio:test": "echo 'Ouvrez https://studio.apollographql.com et connectez-vous à http://localhost:4000/graphql'",
    "db:update": "node scripts/handle-database-update.js",
    "db:update:dry": "node scripts/handle-database-update.js --dry-run",
    "db:invalidate": "curl -X POST http://localhost:4000/api/cache/invalidate-all || echo 'Server not running'",
    "db:stats": "curl http://localhost:4000/api/cache/stats || echo 'Server not running'"
  },
  "repository": {
    "type": "git",
    "url": "github.com/qbolliet/dashboard-template-api"
  },
  "keywords": [
    "GraphQL",
    "DuckDB",
    "API"
  ],
  "author": "Quentin Bolliet",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@duckdb/node-api": "^1.5.2-r.1",
    "@graphql-tools/merge": "^9.0.17",
    "@graphql-tools/schema": "^10.0.16",
    "compression": "^1.7.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "sqlstring": "^2.3.3",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "graphql-request": "^7.2.0",
    "jest": "^30.3.0"
  }
}
