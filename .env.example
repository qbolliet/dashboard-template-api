# =============================================================================
# Configuration de l'API Dashboard Template
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement
# =============================================================================

# ----------------------------
# Environnement
# ----------------------------
NODE_ENV=development
# Valeurs possibles : development | production
ENVIRONMENT=development

# ----------------------------
# Serveur
# ----------------------------
PORT=4000
API_DOMAIN=https://your-production-domain.com

# ----------------------------
# Base de données — DuckLake catalogs
# Un catalogue = un projet/source de données
# ----------------------------
# Catalogue "default"
DEFAULT_CATALOG_PATH=../dashboard-template-database/outputs/default.ducklake
DEFAULT_DATA_PATH=../dashboard-template-database/outputs/default_data/
DEFAULT_READ_ONLY=true
DEFAULT_SCHEMA=main

# Catalogue "macroeconomics" (exemple de second catalogue)
# MACROECONOMICS_CATALOG_PATH=../dashboard-template-database/outputs/macroeconomics.ducklake
# MACROECONOMICS_DATA_PATH=../dashboard-template-database/outputs/macroeconomics_data/
# MACROECONOMICS_READ_ONLY=true
# MACROECONOMICS_SCHEMA=main

# Routage des catalogues
DEFAULT_DATABASE=default
ALLOWED_DATABASES=["default","macroeconomics","public_finance"]
ALLOW_CROSS_DATABASE_QUERIES=false

# Pool de connexions
DB_MAX_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT=60000
DB_POOL_RETRY_DELAY=500

# ----------------------------
# S3 (optionnel, pour catalogues stockés sur S3)
# ----------------------------
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_ENDPOINT=

# ----------------------------
# Redis (cache)
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=graphql-api:
REDIS_CLUSTER=false

# ----------------------------
# Sécurité
# ----------------------------
# Clé API pour les endpoints admin (/api/cache/invalidate-*, /api/cache/stats)
# OBLIGATOIRE en production — choisir une chaîne longue et aléatoire
ADMIN_API_KEY=change-me-in-production

# IPs de proxy de confiance (pour le rate limiting)
# Laisser vide si pas de reverse-proxy, ou mettre ["127.0.0.1"] pour un proxy local
TRUSTED_PROXIES=[]

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_BURST=20
RATE_LIMIT_BURST_WINDOW=60000

# Complexité des requêtes GraphQL
MAX_QUERY_COMPLEXITY=100
DEFAULT_DEPTH_LIMIT=5

# Taille maximale des entrées (caractères)
MAX_INPUT_LENGTH=1000

# ----------------------------
# Pagination
# ----------------------------
DEFAULT_PAGINATION_LIMIT=100
MAX_PAGINATION_LIMIT=1000
MAX_PAGINATION_OFFSET=10000
SELECT_OPTIONS_LIMIT=50

# ----------------------------
# Timeouts (millisecondes)
# ----------------------------
FACT_SIMPLE_TIMEOUT=10000
FACT_COMPLEX_TIMEOUT=15000
AGGREGATED_SIMPLE_TIMEOUT=10000
AGGREGATED_COMPLEX_TIMEOUT=15000
DIMENSION_TIMEOUT=5000
METADATA_TIMEOUT=5000
SELECT_OPTIONS_TIMEOUT=5000

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=info
LOG_ALL_SECURITY_METRICS=false
SLOW_QUERY_THRESHOLD=1000

# ----------------------------
# Requêtes HTTP
# ----------------------------
MAX_REQUEST_SIZE=100kb
MAX_FIELD_SIZE=1000
MAX_FIELDS=50
