# =============================================================================
# Configuration de l'API Dashboard Template
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement.
#
# Seuls les éléments propres à un déploiement (chemins, identifiants, secrets)
# vivent ici. Tous les autres réglages (timeouts, rate limits, complexité,
# pagination, pool, logs, etc.) sont dans `config/*.yaml` avec des défauts
# raisonnables — surchargez-les via env uniquement si nécessaire.
# =============================================================================

# ----------------------------
# Environnement
# ----------------------------
NODE_ENV=development
# Valeurs possibles : development | production
ENVIRONMENT=development

# ----------------------------
# Serveur
# ----------------------------
# Domaine public (utilisé pour les URLs canoniques, CORS, etc.)
API_DOMAIN=https://your-production-domain.com

# ----------------------------
# Bases de données — DuckLake catalogs
# Un catalogue = un projet/source de données
# Les chemins peuvent être locaux (../path/) ou S3 (s3://bucket/...)
# ----------------------------
# Catalogue "default"
DEFAULT_CATALOG_TYPE=file
DEFAULT_CATALOG_PATH=../dashboard-template-database/outputs/default.ducklake
DEFAULT_DATA_PATH=../dashboard-template-database/outputs/default_data/
DEFAULT_READ_ONLY=true
DEFAULT_SCHEMA=main

# Catalogue "macroeconomics" (exemple de second catalogue)
# MACROECONOMICS_CATALOG_TYPE=file
# MACROECONOMICS_CATALOG_PATH=../dashboard-template-database/outputs/macroeconomics.ducklake
# MACROECONOMICS_DATA_PATH=../dashboard-template-database/outputs/macroeconomics_data/
# MACROECONOMICS_READ_ONLY=true
# MACROECONOMICS_SCHEMA=main

# Type de catalogue : "file" (fichier .ducklake statique, défaut) ou "postgres"
# (catalogue mis à jour à chaud par un writer externe, sans conflit de lecture).
# Quand TYPE=postgres, PATH est ignoré : on utilise le bloc POSTGRES ci-dessous et
# DATA_PATH pointe vers le stockage des Parquet (typiquement s3://...).
# Les identifiants (USER/PASSWORD) transitent par un secret DuckDB, jamais loggés.
# DEFAULT_CATALOG_TYPE=postgres
# DEFAULT_PG_HOST=postgres.internal
# DEFAULT_PG_PORT=5432
# DEFAULT_PG_DATABASE=ducklake_catalog
# DEFAULT_PG_USER=dashboard_api
# DEFAULT_PG_PASSWORD=change-me
# DEFAULT_DATA_PATH=s3://my-bucket/default_data/

# Routage des catalogues
DEFAULT_DATABASE=default
ALLOWED_DATABASES=["default","macroeconomics","public_finance"]

# ----------------------------
# S3 (optionnel, pour catalogues stockés sur S3)
# ----------------------------
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_ENDPOINT=

# ----------------------------
# Redis (cache)
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------
# Sécurité
# ----------------------------
# Clé API pour les endpoints admin (/api/cache/invalidate-*, /api/cache/stats)
# OBLIGATOIRE en production — choisir une chaîne longue et aléatoire
ADMIN_API_KEY=change-me-in-production

# IPs / CIDRs de proxy de confiance (pour le rate limiting)
# Laisser [] si pas de reverse-proxy, ou ["127.0.0.1"] / ["10.0.0.0/8"] selon votre setup
TRUSTED_PROXIES=[]
